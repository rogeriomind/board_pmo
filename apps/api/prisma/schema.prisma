generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  email             String            @unique
  passwordHash      String            @map("password_hash")
  avatarUrl         String?           @map("avatar_url")
  assignedActivities Activity[]       @relation("AssigneeActivities")
  createdActivities Activity[]        @relation("CreatedByActivities")
  comments          Comment[]
  history           ActivityHistory[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model Activity {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  status         ActivityStatus    @default(BACKLOG)
  priority       Priority          @default(MEDIUM)
  assigneeId     String?           @map("assignee_id") @db.Uuid
  assignee       User?             @relation("AssigneeActivities", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate        DateTime?         @map("due_date")
  completedAt    DateTime?         @map("completed_at")
  blockedReason  String?           @map("blocked_reason")
  canceledReason String?           @map("canceled_reason")
  createdById    String            @map("created_by") @db.Uuid
  createdBy      User              @relation("CreatedByActivities", fields: [createdById], references: [id])
  tags           ActivityTag[]
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  history        ActivityHistory[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("activities")
}

model Tag {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  color        String
  activityTags ActivityTag[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("tags")
}

model ActivityTag {
  activityId String   @map("activity_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId])
  @@map("activity_tags")
}

model ChecklistItem {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title      String
  isDone     Boolean  @default(false) @map("is_done")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([activityId])
  @@map("checklist_items")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([activityId])
  @@map("comments")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([activityId])
  @@map("attachments")
}

model ActivityHistory {
  id           String   @id @default(uuid()) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
  action       String
  fieldChanged String?  @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([activityId])
  @@map("activity_history")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  active             Boolean             @default(true)
  portfolios         Portfolio[]
  projects           Project[]
  activities         Activity[]
  idempotencyRecords IdempotencyRecord[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("tenants")
}

model Portfolio {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  active      Boolean   @default(true)
  projects    Project[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("portfolios")
}

model Project {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  portfolioId String     @map("portfolio_id") @db.Uuid
  name        String
  description String?
  status      String     @default("ACTIVE")
  health      String?
  startDate   DateTime?  @map("start_date")
  targetDate  DateTime?  @map("target_date")
  ownerId     String?    @map("owner_id") @db.Uuid
  active      Boolean    @default(true)
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  portfolio   Portfolio  @relation(fields: [portfolioId], references: [id])
  owner       User?      @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: SetNull)
  activities  Activity[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([portfolioId])
  @@index([tenantId, updatedAt])
  @@map("projects")
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  email             String            @unique
  passwordHash      String            @map("password_hash")
  avatarUrl         String?           @map("avatar_url")
  ownedProjects     Project[]         @relation("OwnedProjects")
  assignedActivities Activity[]       @relation("AssigneeActivities")
  createdActivities Activity[]        @relation("CreatedByActivities")
  comments          Comment[]
  history           ActivityHistory[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model Activity {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  project        Project           @relation(fields: [projectId], references: [id])
  title          String
  description    String?
  status         ActivityStatus    @default(BACKLOG)
  priority       Priority          @default(MEDIUM)
  assigneeId     String?           @map("assignee_id") @db.Uuid
  assignee       User?             @relation("AssigneeActivities", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate        DateTime?         @map("due_date")
  completedAt    DateTime?         @map("completed_at")
  blockedReason  String?           @map("blocked_reason")
  canceledReason String?           @map("canceled_reason")
  createdById    String            @map("created_by") @db.Uuid
  createdBy      User              @relation("CreatedByActivities", fields: [createdById], references: [id])
  tags           ActivityTag[]
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  history        ActivityHistory[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([tenantId, projectId])
  @@index([projectId, status])
  @@index([projectId, assigneeId, status])
  @@index([projectId, dueDate])
  @@index([tenantId, updatedAt])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("activities")
}

model IdempotencyRecord {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  key             String
  operation       String
  resourceId      String?  @map("resource_id") @db.Uuid
  responsePayload Json     @map("response_payload")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([tenantId, key])
  @@index([tenantId, operation])
  @@map("idempotency_records")
}

model Tag {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  color        String
  activityTags ActivityTag[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("tags")
}

model ActivityTag {
  activityId String   @map("activity_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId])
  @@map("activity_tags")
}

model ChecklistItem {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title      String
  isDone     Boolean  @default(false) @map("is_done")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([activityId])
  @@map("checklist_items")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([activityId])
  @@map("comments")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([activityId])
  @@map("attachments")
}

model ActivityHistory {
  id           String   @id @default(uuid()) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
  action       String
  fieldChanged String?  @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([activityId])
  @@map("activity_history")
}
